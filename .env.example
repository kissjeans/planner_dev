# Database Configuration
# PostgreSQL connection string for task planning database
DATABASE_URL=postgresql+asyncpg://planner:planner@localhost:5432/planner

# Redis Configuration
# Redis cache connection string
REDIS_URL=redis://localhost:6379/0

# Telegram Configuration
# Bot token obtained from BotFather
BOT_TOKEN=your_bot_token_here

# Team chat ID for notifications (obtain from @userinfobot)
TEAM_CHAT_ID=123456789

# LLM Configuration
# Anthropic API key for Claude models
ANTHROPIC_API_KEY=sk-ant-your_key_here

# OpenAI API key for GPT models
OPENAI_API_KEY=sk-your_key_here

# Web Configuration
# Secret for webhook validation (optional, can be empty)
WEBHOOK_SECRET=

# Application Configuration
# Timezone for scheduling (default: Europe/Moscow)
TIMEZONE=Europe/Moscow

# Debug mode (default: false)
DEBUG=false

# Admin session signing secret (REQUIRED in production).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The app refuses to start with DEBUG=false while this is the default.
JWT_SECRET=
